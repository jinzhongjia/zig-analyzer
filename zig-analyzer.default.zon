// Default zig-analyzer settings, with what each option does.
//
// Copy this file to `zig-analyzer.zon` in the project root to share settings with the team; the
// settings in it take precedence over the editor's. Only the options written as fields below can
// be set there. The options in comments marked "editor only" can only be set in the editor.
//
// Editor settings have the same structure, written as JSON in `initializationOptions` or the
// `zig-analyzer` section of `workspace/configuration`:
// `.build = .{ .args = .{"-Dfoo"} }` here is `{ "build": { "args": ["-Dfoo"] } }` there, and enum
// literals such as `.auto` are strings ("auto").
//
// Omitted options keep their defaults. An error in this file (syntax, a wrong type, an unknown
// option) is shown with its location, and the whole file is ignored.
.{
    // The Zig installation (editor only):
    //   .zig = .{
    //       // Path to the `zig` executable. Default: looked up in PATH. It must be the Zig version
    //       // zig-analyzer was built with (0.17.0); otherwise projects with build.zig are not
    //       // loaded. Takes effect after restarting zig-analyzer.
    //       .path = "/usr/local/bin/zig",
    //       // The paths below override what `zig env` reports. A path that is missing or invalid
    //       // is reported, and the detected one is used instead. Relative paths are resolved
    //       // against the working directory of zig-analyzer. A change reloads the standard
    //       // library, and restarts the projects when the lib or cache directory changes.
    //       // Lib directory, which must contain `std/std.zig`: the standard library is read from
    //       // it, and zig runs with ZIG_LIB_DIR set to it.
    //       .lib_path = "/usr/local/lib/zig",
    //       // Existing global cache directory: zig runs with ZIG_GLOBAL_CACHE_DIR set to it.
    //       .global_cache_path = "/home/me/.cache/zig",
    //       // `@import("builtin")` of files outside any project. Default: generated for the
    //       // native target. Modules of a project always use the one of their build settings.
    //       .builtin_path = "/home/me/builtin.zig",
    //   },

    .build = .{
        // Load projects through the build system protocol (`zig build --listen=-`); false handles
        // every file in single-file mode (editor only):
        //   .enable = true,

        // Extra arguments passed to `zig build`, e.g. .{"-Dtarget=aarch64-linux"}.
        .args = .{},
    },

    .diagnostics = .{
        // Build steps for compiler diagnostics. Empty: `check` if the project has it, otherwise the
        // default step. `.step = "name"` adds a single step.
        .steps = .{},
        // Run the compiler on save for diagnostics; false gives only live diagnostics (syntax and
        // AstGen) while typing.
        .compiler = true,

        // Mark code that is not compiled in the current build configuration (branches comptime
        // knows are not taken) as inactive (editor only):
        //   .inactive_code = false,
        // Milliseconds without edits before live diagnostics are computed; 0 for no delay
        // (editor only):
        //   .debounce_ms = 50,
    },

    // Inlay hints (editor only):
    //   .inlay_hints = .{
    //       // Inferred types of local variables without a type annotation.
    //       .types = true,
    //       // Field types after the field names in initializers that have a result type
    //       // (`.{ .x: i32 = 1 }`).
    //       .field_types = true,
    //       // Also show type hints (local variables and fields) whose type has an anonymous
    //       // container, which is shown by its content (`.kind: struct { root: u32 }`).
    //       .anonymous_containers = false,
    //       // Parameter names at call arguments.
    //       .parameters = true,
    //       // Parameter names at builtin call arguments (`@memcpy(dest: a, source: b)`), for
    //       // builtins whose arguments do not show what they are (`@memcpy`, `@cmpxchgStrong`,
    //       // `@Struct`, ...). Needs `.parameters`.
    //       .builtin_parameters = true,
    //       // No parameter names for calls with a single argument (including builtins and
    //       // method calls like `list.append(item)`).
    //       .exclude_single_argument = true,
    //       // Hide the parameter name when the argument already has that name: a variable or a
    //       // field access ending in it, also behind `&`, `.*`, `.?` and `try`.
    //       .hide_redundant_param_names = true,
    //       // Type hints longer than this many characters end with `…` instead of their remaining
    //       // fields or arguments (it may run over by one). 0 never truncates.
    //       .max_length = 25,
    //   },

    // Semantic tokens (editor only):
    //   .semantic_tokens = .{
    //       // .full: every token. .partial: only tokens whose class needs name resolution and
    //       // types (types, functions, namespaces, fields, parameters, ...); keywords, comments,
    //       // literals, operators, labels and built-in names (`@import`, `u32`, `true`) are left to
    //       // the editor's syntax highlighting. Each token sent is the same as in .full.
    //       .mode = .full,
    //       // Mark container-level `var` declarations and their references with the `global`
    //       // modifier.
    //       .global_var = false,
    //   },

    // Completion (editor only):
    //   .completion = .{
    //       // In name completion, also offer reachable declarations and modules that are not
    //       // imported yet, adding the import when one is accepted, and members of visible
    //       // namespaces matched by their whole path (`memeql` -> `std.mem.eql`).
    //       .auto_import = true,
    //       // At most this many auto-import candidates per completion (the best ranked are kept;
    //       // the list is marked incomplete and refreshed as you type); 0 never limits.
    //       .max_auto_imports = 128,
    //       // When the editor supports snippets: functions and builtins complete as calls
    //       // (`add(${1:a}, ${2:b})`; methods called on a value skip the receiver), except where
    //       // `(` already follows or a function value is expected (`&f`, a function-typed
    //       // argument); common snippets are offered where a statement (`if`, `for`, `while`,
    //       // `switch`, `print`, ...) or a declaration (`fn`, `test`, `struct`, `main`, ...)
    //       // starts.
    //       .snippets = true,
    //       // Call snippets get a placeholder for each argument; false inserts only the
    //       // parentheses, with the cursor between them.
    //       .argument_placeholders = true,
    //   },

    // How top-level imports are arranged, by "Organize imports" (`source.organizeImports`) and when
    // auto-import adds one. Imports are grouped std / builtin / root, modules, then files, with a
    // blank line between groups.
    .imports = .{
        // Where declarations derived from an import (`const Allocator = std.mem.Allocator;`) go:
        // .with_import right after the import they come from; .separate in a last group of their
        // own.
        .derived = .with_import,
        // Order within a group: .path by what is imported (module name, file path with nearer
        // files first, the full access path of derived declarations); .name by declaration name.
        .sort = .path,
    },

    // Type inference (editor only):
    //   .sema = .{
    //       // Inside generic functions with no concrete types, infer with the instances from call
    //       // sites (hover, completion, inlay hints, ...).
    //       .callsite_seeding = true,
    //       // Discard all cached type information when the intern pool exceeds this many MB; it
    //       // is recomputed on demand. 0 never discards.
    //       .max_intern_pool_mb = 64,
    //   },

    // Caches (editor only). An evicted value is recomputed when needed, so these limits only
    // trade memory for time; results are the same.
    //   .cache = .{
    //       // Syntax trees kept in memory. 0 keeps all.
    //       .capacity = 64,
    //       // Per query: how many values and how many MB are kept, taking precedence over
    //       // .capacity. Queries: ParseFile, FileAstIdMap (syntax trees, default 64 values and
    //       // 128 MB), FileItemTree (16384, 32 MB), ItemBody (16384, 48 MB), Infer (16384, 48 MB),
    //       // Exports (1024, 16 MB). 0 removes the limit.
    //       .queries = .{ .Infer = .{ .count = 32768, .mb = 96 } },
    //   },

    // Workspace symbols (editor only):
    //   .workspace_symbol = .{
    //       // Also list symbols from dependencies (fetched packages, generated files, opened std
    //       // files).
    //       .dependencies = false,
    //       // At most this many symbols per query (the best matches are kept); 0 never limits.
    //       // Clients that query again as you type do not need more; clients that query once and
    //       // filter on their side (e.g. Neovim's `vim.lsp.buf.workspace_symbol`) may need a higher
    //       // limit or 0.
    //       .limit = 256,
    //   },

    .naming = .{
        // Hint names that do not follow the Names section of the Zig style guide, with rename
        // fixes. Only open files of your own code are checked.
        .enable = false,
        // Names to skip; `*` matches any sequence of characters, e.g. .{"SDL_*"}.
        .ignore = .{},
        // Files to skip: `/`-separated paths relative to the project root (to the workspace root
        // in editor settings); `*` matches any sequence of characters, including `/`.
        .exclude = .{},
        // Turn individual rules on or off; each matches the diagnostic code `naming.<rule>`.
        .rules = .{
            // Types and type aliases: TitleCase.
            .type = true,
            // Callables that return `type`: TitleCase.
            .type_function = true,
            // Other callables (functions, function aliases, function pointers): camelCase.
            .function = true,
            // Namespaces (files with no top-level fields): snake_case.
            .namespace = true,
            // Other values: snake_case.
            .value = true,
            // Fields and enum members, by the type of the field.
            .field = true,
        },
    },

    // Who detects changes on disk (editor only):
    //   .files = .{ .watcher = .auto },
    // .auto: the server watches files when the editor cannot register file watchers;
    // .client: only the editor's notifications; .server: always the server (the editor's
    // notifications are still handled).

    // Logging (editor only):
    //   .log = .{
    //       // .err, .warn, .info or .debug. Logs go to stderr.
    //       .level = .info,
    //       // Also append logs to this file. Default: stderr only.
    //       .file = "/tmp/zig-analyzer.log",
    //       // Log a breakdown of the queries for requests slower than this many milliseconds;
    //       // 0 turns it off.
    //       .slow_request_ms = 100,
    //   },
}
