{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zig",
  "scopeName": "source.zig",
  "fileTypes": [
    "zig",
    "zon"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#fields"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.zig",
          "begin": "//[!/](?=[^/]|$)",
          "end": "$",
          "patterns": [
            {
              "include": "#comment-tasks"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.zig",
          "begin": "//",
          "end": "$",
          "patterns": [
            {
              "include": "#comment-tasks"
            }
          ]
        }
      ]
    },
    "comment-tasks": {
      "match": "\\b(TODO|FIXME|XXX|NOTE)\\b",
      "name": "keyword.todo.zig"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zig",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#format-specifiers"
            }
          ]
        },
        {
          "name": "string.quoted.single.zig",
          "match": "'(?:[^'\\\\]|\\\\(?:[nrt'\"\\\\]|x\\h{2}|u\\{\\h+\\}))'",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#escapes"
                }
              ]
            }
          }
        },
        {
          "name": "string.multiline.zig",
          "match": "(\\\\\\\\).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.string.zig"
            }
          }
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.zig",
          "match": "\\\\(?:[nrt'\"\\\\]|x\\h{2}|u\\{\\h+\\})"
        },
        {
          "name": "invalid.illegal.character.escape.zig",
          "match": "\\\\."
        }
      ]
    },
    "format-specifiers": {
      "name": "constant.other.placeholder.zig",
      "match": "\\{\\{|\\}\\}|\\{(?:[0-9]+|\\[[A-Za-z_][A-Za-z0-9_]*\\])?(?:[a-zA-Z*?!]+)?(?::[^{}]*)?\\}"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.hexadecimal.zig",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*(?:\\.[0-9a-fA-F][0-9a-fA-F_]*(?:[pP][+-]?[0-9][0-9_]*)?|[pP][+-]?[0-9][0-9_]*)\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.zig",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.integer.octal.zig",
          "match": "\\b0o[0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.integer.binary.zig",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.float.decimal.zig",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[eE][+-]?[0-9][0-9_]*)\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.zig",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*|@\"(?:[^\"\\\\]|\\\\.)*\")",
          "captures": {
            "1": {
              "name": "storage.type.function.zig"
            },
            "2": {
              "name": "entity.name.function.zig"
            }
          }
        },
        {
          "match": "\\b(const|var)\\s+([A-Z][A-Za-z0-9_]*)\\s*(?==\\s*(?:extern\\s+|packed\\s+)?(?:struct|enum|union|opaque|error)\\b)",
          "captures": {
            "1": {
              "name": "storage.modifier.zig"
            },
            "2": {
              "name": "entity.name.type.zig"
            }
          }
        },
        {
          "match": "\\b(test)\\s+(?=\"|[A-Za-z_])",
          "captures": {
            "1": {
              "name": "keyword.other.test.zig"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.zig",
          "match": "\\b(if|else|switch|orelse|catch)\\b"
        },
        {
          "name": "keyword.control.repeat.zig",
          "match": "\\b(for|while)\\b"
        },
        {
          "name": "keyword.control.flow.zig",
          "match": "\\b(break|continue|return|unreachable|resume|suspend|nosuspend)\\b"
        },
        {
          "name": "keyword.control.exception.zig",
          "match": "\\b(try|defer|errdefer)\\b"
        },
        {
          "name": "keyword.operator.word.zig",
          "match": "\\b(and|or)\\b"
        },
        {
          "name": "storage.type.zig",
          "match": "\\b(struct|enum|union|opaque|error|fn|anyframe)\\b"
        },
        {
          "name": "storage.modifier.zig",
          "match": "\\b(const|var|pub|extern|export|packed|inline|noinline|comptime|threadlocal|volatile|allowzero|noalias|align|addrspace|linksection|callconv)\\b"
        },
        {
          "name": "keyword.other.zig",
          "match": "\\b(asm|test|usingnamespace|anytype)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.zig",
      "match": "\\b(true|false|null|undefined)\\b"
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.zig",
          "match": "\\b(?:[iu][0-9]+|isize|usize|f16|f32|f64|f80|f128|c_char|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_longdouble|bool|void|noreturn|type|anyerror|anyopaque|comptime_int|comptime_float)\\b"
        },
        {
          "name": "entity.name.type.zig",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b(?!\\s*\\()"
        }
      ]
    },
    "builtins": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)\\b",
      "name": "support.function.builtin.zig"
    },
    "labels": {
      "patterns": [
        {
          "match": "\\b(break|continue)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.flow.zig"
            },
            "2": {
              "name": "punctuation.separator.label.zig"
            },
            "3": {
              "name": "entity.name.label.zig"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(:)\\s*(?=\\{|for\\b|while\\b|inline\\b|switch\\b)",
          "captures": {
            "1": {
              "name": "entity.name.label.zig"
            },
            "2": {
              "name": "punctuation.separator.label.zig"
            }
          }
        }
      ]
    },
    "calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.zig"
        }
      }
    },
    "fields": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?==[^=])",
          "captures": {
            "1": {
              "name": "punctuation.accessor.zig"
            },
            "2": {
              "name": "variable.other.member.zig"
            }
          }
        },
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.zig"
            },
            "2": {
              "name": "variable.other.member.zig"
            }
          }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(:)(?!\\s*\\{)",
          "captures": {
            "1": {
              "name": "variable.other.member.zig"
            },
            "2": {
              "name": "punctuation.separator.zig"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.zig",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.zig",
          "match": "==|!=|<=|>=|<(?!<)|>(?!>)"
        },
        {
          "name": "keyword.operator.assignment.zig",
          "match": "(?:\\+%|\\+\\||-%|-\\||\\*%|\\*\\||<<\\||<<|>>|[-+*/%&|^])?="
        },
        {
          "name": "keyword.operator.arithmetic.zig",
          "match": "\\+\\+|\\*\\*|\\+%|\\+\\||-%|-\\||\\*%|\\*\\||<<\\||<<|>>|[-+*/%]"
        },
        {
          "name": "keyword.operator.bitwise.zig",
          "match": "[&|^~]"
        },
        {
          "name": "keyword.operator.logical.zig",
          "match": "!"
        },
        {
          "name": "keyword.operator.unwrap.zig",
          "match": "\\.\\?|\\.\\*|\\?"
        },
        {
          "name": "keyword.operator.range.zig",
          "match": "\\.\\.\\.?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.zig",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.zig",
          "match": ","
        },
        {
          "name": "punctuation.section.braces.zig",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.zig",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.zig",
          "match": "[()]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.zig",
          "match": "@\"(?:[^\"\\\\]|\\\\.)*\""
        },
        {
          "name": "variable.other.zig",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
